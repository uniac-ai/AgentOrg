{
  "name": "agentorg",
  "description": "Fill a position in an agentorg organization from a Claude Code session: the agent actor's MCP server, the hooks that deliver messages and wake the session, and the task-execution and reporting skills.",
  "author": {
    "name": "The agentorg authors"
  },
  "homepage": "https://github.com/uniac-ai/AgentOrg",
  "repository": "https://github.com/uniac-ai/AgentOrg",
  "license": "MIT",
  "mcpServers": {
    "org": {
      "command": "agentorg",
      "args": [
        "agent",
        "--client",
        "claude-code"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentorg agent context --client claude-code",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "agentorg agent wait --client claude-code",
            "asyncRewake": true,
            "timeout": 604800,
            "rewakeMessage": "From the agentorg plugin:",
            "rewakeSummary": "agentorg message"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentorg agent wait --client claude-code",
            "asyncRewake": true,
            "timeout": 604800,
            "rewakeMessage": "From the agentorg plugin:",
            "rewakeSummary": "agentorg message"
          }
        ]
      }
    ]
  }
}

# systemd user unit that keeps `agentorg serve` running.
# Install it as ~/.config/systemd/user/agentorg.service (docs/install.md).
# ExecStart assumes agentorg is installed in ~/.local/bin, where pipx puts it;
# change the path if `command -v agentorg` prints another one.

[Unit]
Description=agentorg service
Documentation=https://github.com/uniac-ai/agentorg/blob/main/docs/install.md

[Service]
ExecStart=%h/.local/bin/agentorg serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

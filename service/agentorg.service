# systemd user unit that keeps `agentorg serve` running.
# docs/install.md replaces @NODE@ and @AGENTORG@ with the absolute paths of node
# and the agentorg command, since the user manager's PATH may not hold them, and
# installs it as ~/.config/systemd/user/agentorg.service.

[Unit]
Description=agentorg service
Documentation=https://github.com/uniac-ai/agentorg/blob/main/docs/install.md

[Service]
ExecStart=@NODE@ @AGENTORG@ serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

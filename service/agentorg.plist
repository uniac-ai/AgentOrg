<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent that keeps `agentorg core` running.
  launchd expands neither `~` nor environment variables, and its PATH holds
  only the system directories, so the job names node itself. docs/install.md
  replaces @NODE@ and @AGENTORG@ with the absolute paths of node and the
  agentorg command, and @AGENTORG_HOME@ with the agentorg home.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>agentorg</string>
	<key>ProgramArguments</key>
	<array>
		<string>@NODE@</string>
		<string>@AGENTORG@</string>
		<string>core</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@AGENTORG_HOME@/logs/core.log</string>
	<key>StandardErrorPath</key>
	<string>@AGENTORG_HOME@/logs/core.log</string>
</dict>
</plist>

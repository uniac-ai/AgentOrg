{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["src/**", "test/**", "*.json", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": ["src/**", "test/**"],
      "linter": {
        "rules": { "correctness": { "usePlaywrightValidDescribeCallback": "off" } }
      }
    }
  ]
}

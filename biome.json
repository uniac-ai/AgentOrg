{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["src/**", "test/**", "web/**", "*.json", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "test/**"],
      "linter": {
        "rules": { "correctness": { "usePlaywrightValidDescribeCallback": "off" } }
      }
    }
  ]
}

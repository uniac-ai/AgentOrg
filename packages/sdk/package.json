{
  "name": "@agentorg/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Define interfaces and Actors, and connect them to the Hub.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "default": "./dist/src/cli.js"
    },
    "./person-commands": {
      "types": "./dist/src/person-commands.d.ts",
      "default": "./dist/src/person-commands.js"
    },
    "./http": {
      "types": "./dist/src/client-http.d.ts",
      "default": "./dist/src/client-http.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test --test-timeout=60000 \"dist/test/**/*.test.js\""
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@agentorg/wire": "0.0.0"
  },
  "bin": {
    "agentorg-sdk": "dist/src/cli.js"
  }
}

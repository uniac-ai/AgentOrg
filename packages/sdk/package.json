{
  "name": "@agentorg/sdk",
  "version": "0.0.0",
  "description": "Define interfaces, Actors and widgets, and build AgentOrg packages.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    },
    "./build": {
      "types": "./dist/src/build.d.ts",
      "default": "./dist/src/build.js"
    },
    "./describe": {
      "types": "./dist/src/describe.d.ts",
      "default": "./dist/src/describe.js"
    },
    "./manifest": {
      "types": "./dist/src/manifest-api.d.ts",
      "default": "./dist/src/manifest-api.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "bin": {
    "agentorg": "dist/src/cli.js"
  }
}

{
  "name": "chatgpt",
  "version": "0.0.1",
  "private": true,
  "description": "Sign in with ChatGPT, and model inference on the person's ChatGPT plan",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./fake-openai": {
      "types": "./dist/test/fake-openai.d.ts",
      "default": "./dist/test/fake-openai.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentorg/hub": "0.0.0"
  }
}

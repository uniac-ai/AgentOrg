{
  "name": "@agentorg/cli",
  "version": "0.0.12",
  "description": "AgentOrg as one app: the Hub, the person's gateway and the shell, on loopback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniac-ai/AgentOrg.git",
    "directory": "packages/app"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "agentorg": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "static"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test --test-timeout=60000 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@agentorg/computer-connector": "0.0.0",
    "@agentorg/hub": "0.0.0",
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/manager": "0.0.0",
    "@agentorg/mcp": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "@agentorg/shell": "0.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "^8.20.0",
    "assistant": "0.0.1",
    "chatgpt": "0.0.1",
    "react-diff-view": "3.3.3",
    "ws": "^8.22.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentorg/computer": "0.0.18",
    "@playwright/test": "1.64.1",
    "@types/ws": "^8.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

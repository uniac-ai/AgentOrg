{
  "name": "@agentorg/cli",
  "version": "0.0.5",
  "description": "AgentOrg as one app: the Hub, the person's gateway and the shell, on loopback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniac-ai/AgentOrg.git",
    "directory": "packages/app"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "agentorg": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/bundled",
    "static"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/bundle.js",
    "test": "node --test --test-timeout=60000 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@agentorg/hub": "0.0.0",
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/kit": "0.0.0",
    "@agentorg/manager": "0.0.0",
    "@agentorg/mcp": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "@agentorg/shell": "0.0.0",
    "@assistant-ui/react": "^0.15.32",
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "^8.20.0",
    "assistant": "0.0.1",
    "chatgpt": "0.0.1",
    "esbuild": "0.28.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.19.1",
    "remark-gfm": "^4.0.1",
    "remend": "^1.4.0",
    "ws": "^8.22.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/ws": "^8.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@agentorg/computer": "0.0.20",
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/mcp": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentorg/hub": "0.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/ws": "^8.18.2"
  }
}

{
  "name": "@agentorg/computer-connector",
  "version": "0.0.0",
  "private": true,
  "description": "The computer unit: a terminal and files for an agent, on a machine the person chooses",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }

{
  "name": "@agentorg/mac-window",
  "version": "0.0.0",
  "private": true,
  "description": "The AgentOrg Mac app's window: whether AgentOrg has connected, and what this Mac lends.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.test.json && node scripts/build.js",
    "dev": "node scripts/build.js --serve",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=3 --test-timeout=60000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  }
}

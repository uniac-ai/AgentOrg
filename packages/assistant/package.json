{
  "name": "assistant",
  "version": "0.0.1",
  "private": true,
  "description": "An agent that chats, and acts through the connections it's given",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "agentorg": {
    "modules": {
      "logic": "src/logic.ts",
      "chat": "src/chat.ts"
    },
    "connections": [
      [
        "chat.chat",
        "logic.chat"
      ]
    ]
  },
  "dependencies": {
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

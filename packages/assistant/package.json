{
  "name": "assistant",
  "version": "0.0.1",
  "private": true,
  "description": "The agent engine, and the bundled provider that runs it",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./provider": {
      "types": "./dist/src/provider.d.ts",
      "default": "./dist/src/provider.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/looper": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentorg/hub": "0.0.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOrg",
  "mainBinaryName": "AgentOrg",
  "version": "../../app/package.json",
  "identifier": "ai.uniac.agentorg",
  "build": {
    "frontendDist": "../../mac-window/dist",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build --workspace @agentorg/mac-window",
    "beforeDevCommand": "npm run dev --workspace @agentorg/mac-window"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AgentOrg",
        "width": 460,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 16.5 },
        "backgroundColor": "#191919"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchAgents/ai.uniac.agentorg.provider.plist": "provider.plist",
        "MacOS/node": "target/assembly/bundle/MacOS/node",
        "Resources/cua-driver": "target/assembly/bundle/Resources/cua-driver",
        "Resources/agentcomputer": "target/assembly/bundle/Resources/agentcomputer",
        "Resources/licenses": "target/assembly/bundle/Resources/licenses",
        "Resources/cursor-themes": "target/assembly/bundle/Resources/cursor-themes"
      }
    }
  }
}

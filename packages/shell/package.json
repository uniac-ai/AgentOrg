{
  "name": "@agentorg/shell",
  "version": "0.0.0",
  "private": true,
  "description": "The person's web shell for AgentOrg: their agents, their views and their settings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    "./package.json": "./package.json",
    "./agent-bindings": {
      "types": "./src/agent-bindings.ts",
      "default": "./dist/agent-bindings.js"
    }
  },
  "files": [
    "dist",
    "src/agent-bindings.ts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.test.json && node scripts/build.js",
    "test": "node --experimental-strip-types --no-warnings --test --test-timeout=60000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@agentorg/interfaces": "0.0.0",
    "@agentorg/kit": "0.0.0",
    "@agentorg/sdk": "0.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  }
}

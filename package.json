{
  "name": "@agentorg/cli",
  "version": "0.0.1",
  "description": "An organization of AI agents run like a company: actors are positions with managers, and calls go up and down, over MCP in both directions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniac-ai/AgentOrg.git"
  },
  "homepage": "https://github.com/uniac-ai/AgentOrg#readme",
  "bugs": {
    "url": "https://github.com/uniac-ai/AgentOrg/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentorg": "dist/src/cli/bin.js"
  },
  "exports": {
    "./actor": {
      "types": "./dist/src/actor/index.d.ts",
      "default": "./dist/src/actor/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/page",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:page",
    "build:page": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:page": "vite --config web/vite.config.ts",
    "prepack": "npm run build",
    "check": "biome check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.14",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

{
  "name": "@agentorg/cli",
  "version": "0.0.0",
  "description": "A local service that organizes AI agent sessions like a company: agents, asks to the manager, and reports up",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniac-ai/agentorg.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentorg": "dist/src/cli/bin.js"
  },
  "files": [
    "dist/src",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "openapi": "npm run build && node dist/src/api/print-openapi.js > openapi.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
